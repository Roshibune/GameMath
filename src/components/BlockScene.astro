---
import "../styles/feedback.css";

interface Props {
  groups: number;
  perGroup: number | null;
  /** Total de itens. Usado no modo "pile" (divisão, antes da resposta). */
  total?: number;
  /**
   * "groups": itens organizados em grupos.
   * "pile": um monte só, sem mostrar a divisão (não revela a resposta).
   */
  mode?: "groups" | "pile";
}

const { groups, perGroup, total, mode = "groups" } = Astro.props;
const itemsPerGroup = perGroup ?? 0;
const pileSize = total ?? groups * itemsPerGroup;

// O texto para leitor de tela também não pode revelar a resposta no modo "pile".
const label =
  mode === "pile"
    ? `${pileSize} itens juntos`
    : `${groups} grupos com ${itemsPerGroup} itens em cada`;
---

<div class="scene" data-scene data-mode={mode} role="img" aria-label={label}>
  {
    mode === "pile" ? (
      <div class="pile">
        {Array.from({ length: pileSize }, () => (
          <span class="block" />
        ))}
      </div>
    ) : (
      Array.from({ length: groups }, (_, g) => (
        <div class="group" style={`--i:${g}`}>
          {Array.from({ length: itemsPerGroup }, () => (
            <span class="block" />
          ))}
        </div>
      ))
    )
  }
</div>