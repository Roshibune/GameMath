---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Painel do professor — GameMath">
  <main class="prof">
    <p id="prof-loading" role="status">Carregando…</p>

    <!-- Painel -->
    <div id="prof-painel" hidden>
      <div class="prof-top">
        <div>
          <h1>Painel da turma</h1>
          <span id="prof-nome" class="prof-mut"></span>
        </div>
        <button type="button" id="prof-sair" class="prof-sec">Sair</button>
      </div>

      <section class="prof-card">
        <h2>Código para os alunos se vincularem</h2>
        <span id="prof-codigo" class="prof-code">…</span>
        <button type="button" id="prof-copiar" class="prof-sec" disabled>Copiar</button>
        <p id="prof-codigo-msg" class="prof-mut" role="status"></p>
      </section>

      <section class="prof-card">
        <h2>Desempenho da turma</h2>
        <div id="prof-resumo" class="prof-stats"></div>
      </section>

      <section class="prof-card">
        <h2>Alunos vinculados</h2>
        <p id="prof-lista-msg" class="prof-mut" role="status"></p>
        <div class="prof-tw">
          <table id="prof-tabela" hidden>
            <thead>
              <tr>
                <th>Aluno</th><th>Partidas</th><th>Acertos</th>
                <th>Multiplicação</th><th>Divisão</th><th>Última partida</th>
              </tr>
            </thead>
            <tbody id="prof-corpo"></tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <script>
    // Modo de teste: com PUBLIC_USE_MOCK=true (e só em desenvolvimento) usa dados
    // falsos de src/lib/supabase.mock.ts. Em produção, sempre usa o Supabase real.
    const usarMock =
      import.meta.env.DEV &&
      (import.meta.env.PUBLIC_USE_MOCK === "true" ||
        new URLSearchParams(location.search).get("mock") === "1");
    const { supabase } = usarMock
      ? await import("../lib/supabase.mock")
      : await import("../lib/supabase");

    type Attempt = {
      student_id: string;
      operation: "multiplication" | "division";
      total_questions: number;
      correct_answers: number;
      completed_at: string;
    };

    const $ = <T extends HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const pct = (a: number, t: number) => (t > 0 ? Math.round((a / t) * 100) : null);
    const fmtPct = (a: number, t: number) => {
      const p = pct(a, t);
      return p === null ? "—" : `${p}%`;
    };
    const fmtData = (iso: string | null) =>
      iso ? new Date(iso).toLocaleDateString("pt-BR") : "—";

    // Sempre textContent: nunca insere dados do banco como HTML.
    function celula(texto: string): HTMLTableCellElement {
      const td = document.createElement("td");
      td.textContent = texto;
      return td;
    }

    // O login é feito na página de login do grupo (Integrante 1), que depois
    // redireciona o professor para cá. Ajuste o endereço se for outro.
    const LOGIN_URL = "/login";

    function mostrar(qual: "loading" | "painel") {
      $("prof-loading").hidden = qual !== "loading";
      $("prof-painel").hidden = qual !== "painel";
    }

    function erroTela(msg: string) {
      $("prof-loading").textContent = msg;
      mostrar("loading");
    }

    function irParaLogin() {
      window.location.href = LOGIN_URL;
    }

    // ---------- Código do professor (função teacher-code) ----------
    async function carregarCodigo() {
      const codigoEl = $("prof-codigo");
      const msgEl = $("prof-codigo-msg");
      const btn = $<HTMLButtonElement>("prof-copiar");
      msgEl.textContent = "";
      btn.disabled = true;

      const { data, error } = await supabase.functions.invoke("teacher-code", {
        method: "POST",
      });

      if (error || !data?.code) {
        codigoEl.textContent = "—";
        msgEl.textContent = "Não foi possível carregar o código. Tente recarregar a página.";
        return;
      }
      codigoEl.textContent = data.code;
      btn.disabled = false;
    }

    $("prof-copiar").addEventListener("click", async () => {
      const msgEl = $("prof-codigo-msg");
      try {
        await navigator.clipboard.writeText($("prof-codigo").textContent ?? "");
        msgEl.textContent = "Código copiado!";
      } catch {
        msgEl.textContent = "Não deu para copiar. Selecione o código e copie manualmente.";
      }
    });

    // ---------- Alunos e desempenho ----------
    // O banco (RLS) já devolve só os alunos e partidas deste professor.
    async function carregarAlunos(teacherId: string) {
      const msg = $("prof-lista-msg");
      const tabela = $("prof-tabela");
      const corpo = $("prof-corpo");
      const resumo = $("prof-resumo");
      corpo.replaceChildren();
      resumo.replaceChildren();
      tabela.hidden = true;
      msg.textContent = "Carregando alunos…";

      const { data: vinculos, error: e1 } = await supabase
        .from("student_teacher_links")
        .select("student_id")
        .eq("teacher_id", teacherId)
        .is("unlinked_at", null);

      if (e1) {
        msg.textContent = "Não foi possível carregar os alunos. Tente novamente.";
        return;
      }

      const ids = (vinculos ?? []).map((v) => v.student_id as string);
      if (ids.length === 0) {
        msg.textContent = "Nenhum aluno vinculado ainda. Passe o código acima para a turma.";
        montarResumo(resumo, 0, []);
        return;
      }

      const [perfisRes, partidasRes] = await Promise.all([
        supabase.from("profiles").select("user_id, nickname").in("user_id", ids),
        supabase
          .from("game_attempts")
          .select("student_id, operation, total_questions, correct_answers, completed_at")
          .in("student_id", ids)
          .order("completed_at", { ascending: false }),
      ]);

      if (perfisRes.error || partidasRes.error) {
        msg.textContent = "Não foi possível carregar o desempenho. Tente novamente.";
        return;
      }

      const partidas = (partidasRes.data ?? []) as Attempt[];
      const perfis = (perfisRes.data ?? []) as { user_id: string; nickname: string }[];
      perfis.sort((a, b) => a.nickname.localeCompare(b.nickname, "pt-BR"));

      for (const p of perfis) {
        const minhas = partidas.filter((x) => x.student_id === p.user_id);
        const soma = (f: (x: Attempt) => boolean, k: "correct_answers" | "total_questions") =>
          minhas.filter(f).reduce((s, x) => s + x[k], 0);
        const isMult = (x: Attempt) => x.operation === "multiplication";
        const isDiv = (x: Attempt) => x.operation === "division";
        const acertos = soma(() => true, "correct_answers");
        const total = soma(() => true, "total_questions");

        const tr = document.createElement("tr");
        tr.append(
          celula(p.nickname),
          celula(String(minhas.length)),
          celula(total ? `${acertos}/${total} (${fmtPct(acertos, total)})` : "—"),
          celula(fmtPct(soma(isMult, "correct_answers"), soma(isMult, "total_questions"))),
          celula(fmtPct(soma(isDiv, "correct_answers"), soma(isDiv, "total_questions"))),
          celula(fmtData(minhas[0]?.completed_at ?? null)),
        );
        corpo.appendChild(tr);
      }

      msg.textContent = "";
      tabela.hidden = false;
      montarResumo(resumo, perfis.length, partidas);
    }

    function montarResumo(alvo: HTMLElement, alunos: number, partidas: Attempt[]) {
      const soma = (f: (x: Attempt) => boolean, k: "correct_answers" | "total_questions") =>
        partidas.filter(f).reduce((s, x) => s + x[k], 0);
      const all = () => true;
      const itens: [string, string][] = [
        [String(alunos), "alunos vinculados"],
        [String(partidas.length), "partidas jogadas"],
        [fmtPct(soma(all, "correct_answers"), soma(all, "total_questions")), "acertos no geral"],
        [
          fmtPct(
            soma((x) => x.operation === "multiplication", "correct_answers"),
            soma((x) => x.operation === "multiplication", "total_questions"),
          ),
          "multiplicação",
        ],
        [
          fmtPct(
            soma((x) => x.operation === "division", "correct_answers"),
            soma((x) => x.operation === "division", "total_questions"),
          ),
          "divisão",
        ],
      ];
      alvo.replaceChildren();
      for (const [valor, rotulo] of itens) {
        const box = document.createElement("div");
        box.className = "prof-stat";
        const b = document.createElement("b");
        b.textContent = valor;
        const s = document.createElement("span");
        s.className = "prof-mut";
        s.textContent = rotulo;
        box.append(b, s);
        alvo.appendChild(box);
      }
    }

    // ---------- Sessão ----------
    async function abrirPainel(userId: string) {
      mostrar("loading");
      const { data: perfil, error } = await supabase
        .from("profiles")
        .select("role, nickname")
        .eq("user_id", userId)
        .maybeSingle();

      if (error) {
        erroTela("Não foi possível carregar seu perfil. Tente recarregar a página.");
        return;
      }
      if (perfil?.role !== "teacher") {
        erroTela("Esta área é exclusiva para professores.");
        return;
      }

      $("prof-nome").textContent = perfil.nickname;
      mostrar("painel");
      await Promise.all([carregarCodigo(), carregarAlunos(userId)]);
    }

    $("prof-sair").addEventListener("click", async () => {
      await supabase.auth.signOut();
      irParaLogin();
    });

    // Modo de teste: entra sozinho como professor falso, sem a página de login.
    // ?mock=1 (professor 1) | ?mock=1&user=2 (professor 2) | ?mock=1&user=aluno
    if (usarMock) {
      const u = new URLSearchParams(location.search).get("user");
      const email =
        u === "2" ? "prof2@teste.com" : u === "aluno" ? "aluno@teste.com" : "prof@teste.com";
      const { data: atual } = await supabase.auth.getSession();
      if (u || !atual.session) {
        await supabase.auth.signInWithPassword({ email, password: "1234" });
      }
    }

    // O Supabase guarda a sessão no navegador, então quem entrou na página de
    // login chega aqui já logado. Sem sessão, volta para o login.
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      await abrirPainel(session.user.id);
    } else {
      irParaLogin();
    }
  </script>
</Layout>

<style is:global>
  .prof {
    max-width: 70rem;
    margin: 0 auto;
    padding: 1rem;
  }

  .prof h1 {
    margin: 0;
    color: var(--gm-text, #172554);
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .prof h2 {
    margin: 0 0 1rem;
    color: var(--gm-text, #172554);
    font-size: 1.2rem;
  }

  .prof-mut {
    color: var(--gm-muted, #475569);
    font-size: 0.95rem;
  }

  .prof-card {
    margin-bottom: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--gm-border, #d7e0f5);
    border-radius: 1rem;
    background: #f8faff;
  }

  .prof button {
    min-height: 44px;
    padding: 0.65rem 1rem;
    border: 2px solid var(--gm-primary, #3158c9);
    border-radius: 0.7rem;
    background: var(--gm-primary, #3158c9);
    color: #ffffff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .prof button:hover:not(:disabled) {
    border-color: var(--gm-primary-hover, #2445a8);
    background: var(--gm-primary-hover, #2445a8);
  }

  .prof button.prof-sec {
    border-color: var(--gm-border, #d7e0f5);
    background: #ffffff;
    color: var(--gm-text, #172554);
  }

  .prof button.prof-sec:hover:not(:disabled) {
    background: #edf2ff;
  }

  .prof button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .prof-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .prof-code {
    display: inline-block;
    max-width: 100%;
    margin: 0 0.75rem 0.5rem 0;
    padding: 0.6rem 0.9rem;
    overflow-wrap: anywhere;
    border: 2px dashed var(--gm-primary, #3158c9);
    border-radius: 0.75rem;
    background: #ffffff;
    color: var(--gm-primary-hover, #2445a8);
    font-family: ui-monospace, Consolas, monospace;
    font-size: clamp(1.2rem, 4vw, 1.7rem);
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .prof-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
  }

  .prof-stat {
    padding: 1rem;
    border: 1px solid var(--gm-border, #d7e0f5);
    border-radius: 0.85rem;
    background: #ffffff;
  }

  .prof-stat b {
    display: block;
    color: var(--gm-primary-hover, #2445a8);
    font-size: 1.5rem;
  }

  .prof-stat .prof-mut {
    display: block;
    margin-top: 0.25rem;
  }

  .prof-tw {
    overflow-x: auto;
    border: 1px solid var(--gm-border, #d7e0f5);
    border-radius: 0.75rem;
    background: #ffffff;
  }

  .prof table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
  }

  .prof th,
  .prof td {
    padding: 0.8rem;
    border-bottom: 1px solid var(--gm-border, #d7e0f5);
    text-align: left;
  }

  .prof th {
    background: #edf2ff;
    color: var(--gm-text, #172554);
    font-size: 0.85rem;
  }

  .prof tbody tr:hover {
    background: #f8faff;
  }

  .prof tbody tr:last-child td {
    border-bottom: 0;
  }

  @media (max-width: 38rem) {
    .prof {
      padding: 0.5rem;
    }

    .prof-top {
      align-items: stretch;
    }

    .prof-top > button {
      width: 100%;
    }
  }
</style>