---
import Layout from "../../layouts/Layout.astro";
import BlockScene from "../../components/BlockScene.astro";

// Esta página é só para desenvolvimento.
if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}

const animations = [
  { id: "soft_shake", label: "Balanço leve" },
  { id: "merge_blocks", label: "Juntar grupos" },
  { id: "extra_item_each_group", label: "Um a mais em cada" },
  { id: "regroup", label: "Reagrupar" },
  { id: "celebrate", label: "Acerto" },
  { id: "none", label: "Nenhuma" },
];
---

<Layout title="Teste de feedback — GameMath">
  <main>
    <h1>Teste das animações de feedback</h1>

    <section id="demo-mult">
      <h2>Multiplicação: 5 baús com 4 moedas cada</h2>
      <BlockScene groups={5} perGroup={4} />

      <div>
        {
          animations.map((a) => (
            <button type="button" data-play={a.id}>{a.label}</button>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Divisão: 12 balas entre 3 amigos</h2>

      <h3>Antes de responder (modo pile)</h3>
      <BlockScene groups={3} perGroup={4} total={12} mode="pile" />

      <h3>Depois de responder (modo groups)</h3>
      <BlockScene groups={3} perGroup={4} />
    </section>
  </main>

  <script>
    import { playFeedback, type SceneAnimation } from "../../lib/feedback";

    // Os botões controlam só a cena da multiplicação.
    const scene = document.querySelector<HTMLElement>("#demo-mult [data-scene]")!;
    document.querySelectorAll<HTMLButtonElement>("[data-play]").forEach((button) => {
      button.addEventListener("click", () => {
        playFeedback(scene, button.dataset.play as SceneAnimation);
      });
    });
  </script>
</Layout>