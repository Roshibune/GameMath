---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="Escolher operação — GameMath">
  <main class="escolha-operacao">
    <p id="mensagem-acesso" role="status" aria-live="polite">
      Verificando seu acesso...
    </p>

    <div id="opcoes-aluno" hidden>
      <h1>O que você quer praticar hoje?</h1>
      <div class="opcoes-operacao">
        <a href="/aluno/jogar/explicacao/multiplicacao" class="opcao-operacao">
          <span class="opcao-emoji" aria-hidden="true">✖️</span>
          Multiplicação
        </a>
        <a href="/aluno/jogar/explicacao/divisao" class="opcao-operacao">
          <span class="opcao-emoji" aria-hidden="true">➗</span>
          Divisão
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .escolha-operacao {
    max-width: 56rem;
    text-align: center;
  }

  .escolha-operacao h1 {
    margin-bottom: 1.5rem;
  }

  .opcoes-operacao {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .opcao-operacao {
    display: flex;
    min-height: 13rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 3px solid var(--gm-border, #d7e0f5);
    border-radius: 1.25rem;
    background: linear-gradient(145deg, #ffffff, #f1f5ff);
    box-shadow: 0 6px 16px rgb(31 45 93 / 7%);
    color: var(--gm-text, #172554);
    font-size: 1.3rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      transform 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .opcao-operacao:hover {
    transform: translateY(-3px);
    border-color: var(--gm-primary, #3158c9);
    box-shadow: 0 10px 22px rgb(31 45 93 / 12%);
    color: var(--gm-primary-hover, #2445a8);
  }

  .opcao-emoji {
    font-size: 3rem;
    line-height: 1;
  }

  @media (max-width: 38rem) {
    .opcoes-operacao {
      grid-template-columns: 1fr;
    }

    .opcao-operacao {
      min-height: 9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opcao-operacao {
      transition: none;
    }

    .opcao-operacao:hover {
      transform: none;
    }
  }
</style>

<script>
  import { supabase } from "../../../lib/supabase";

  const mensagem =
    document.querySelector<HTMLElement>("#mensagem-acesso")!;
  const opcoesAluno =
    document.querySelector<HTMLElement>("#opcoes-aluno")!;

  const {
    data: { session },
    error: erroSessao,
  } = await supabase.auth.getSession();

  if (erroSessao) {
    mensagem.textContent =
      "Não foi possível verificar seu acesso. Tente novamente.";
  } else if (!session) {
    window.location.replace("/login");
  } else {
    const { data: perfil, error: erroPerfil } = await supabase
      .from("profiles")
      .select("role")
      .eq("user_id", session.user.id)
      .maybeSingle();

    if (erroPerfil) {
      mensagem.textContent =
        "Não foi possível verificar seu perfil. Tente novamente.";
    } else if (perfil?.role === "teacher") {
      window.location.replace("/professor");
    } else if (perfil?.role === "student") {
      mensagem.hidden = true;
      opcoesAluno.hidden = false;
    } else {
      await supabase.auth.signOut();
      window.location.replace("/login");
    }
  }
</script>