---
import Layout from "../../../layouts/Layout.astro";
import FeedbackPanel from "../../../components/FeedbackPanel.astro";
import "../../../styles/feedback.css";
import "../../../styles/game.css";
import type { Operation } from "../../../lib/questions/types";

export function getStaticPaths() {
  return [
    {
      params: { operacao: "multiplicacao" },
      props: { operation: "multiplication" as Operation },
    },
    {
      params: { operacao: "divisao" },
      props: { operation: "division" as Operation },
    },
  ];
}

const { operation } = Astro.props;
const titulo = operation === "multiplication" ? "Multiplicação" : "Divisão";
---

<Layout title={`${titulo} — GameMath`}>
  <main data-operation={operation} class="jogo-pagina">
    <p id="mensagem-acesso" role="status" aria-live="polite">
      Verificando seu acesso...
    </p>

    <div id="area-jogo" hidden>
      <h1>{titulo}</h1>

      <div id="estado-carregando">Buscando perguntas...</div>

      <div id="estado-erro" hidden>
        <p>Não deu para carregar ou salvar a partida agora. Tente de novo.</p>
        <button id="btn-tentar-de-novo" type="button" class="botao-secundario">
          Tentar de novo
        </button>
      </div>

      <div id="estado-vazio" hidden>
        <p>
          Ainda não há perguntas suficientes de {titulo.toLowerCase()} para
          jogar uma partida completa. Volte mais tarde!
        </p>
        <a href="/aluno/jogar" class="botao-secundario">Escolher outra operação</a>
      </div>

      <section id="jogo" class="game" hidden>
        <p id="progresso" class="progresso"></p>
        <h2
          id="pergunta"
          class="game-prompt"
          tabindex="-1"
          data-prompt
        ></h2>
        <div class="scene" data-scene role="img"></div>
        <div
          class="options"
          data-options
          role="group"
          aria-labelledby="pergunta"
        ></div>

        <FeedbackPanel />

        <button
          id="btn-proxima"
          type="button"
          class="game-next botao-principal"
          hidden
        >
          Próxima pergunta
        </button>
      </section>

      <section id="resultado" hidden>
        <h2>Resultado</h2>
        <p id="resultado-texto" class="resultado-texto"></p>
        <a href="/aluno/jogar" class="botao-principal">Jogar de novo</a>
      </section>
    </div>
  </main>
</Layout>

<style>
  .jogo-pagina {
    max-width: 42rem;
    margin: 1.5rem auto;
  }

  .jogo-pagina > h1 {
    text-align: center;
  }

  #estado-carregando,
  #estado-erro,
  #estado-vazio,
  #resultado {
    margin: 1rem auto;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--gm-border, #d7e0f5);
    border-radius: var(--gm-radius, 1.25rem);
    background: var(--gm-surface, #ffffff);
    text-align: center;
  }

  .progresso {
    display: inline-block;
    margin: 0;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: #edf2ff;
    color: var(--gm-primary-hover, #2445a8);
    font-weight: 700;
  }

  .resultado-texto {
    font-size: 1.1rem;
  }

  .botao-principal,
  .botao-secundario {
    display: inline-flex;
    min-height: var(--gm-tap-size, 44px);
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.9rem;
    border: 2px solid transparent;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
  }

  .botao-principal {
    border-color: var(--gm-primary, #3158c9);
    background: var(--gm-primary, #3158c9);
    color: #ffffff;
  }

  .botao-principal:hover {
    border-color: var(--gm-primary-hover, #2445a8);
    background: var(--gm-primary-hover, #2445a8);
  }

  .botao-secundario {
    border-color: var(--gm-border, #d7e0f5);
    background: #ffffff;
    color: var(--gm-text, #172554);
  }
</style>

<script>
  import { supabase } from "../../../lib/supabase";
  import { buildFeedback, buildResultMessage } from "../../../lib/messages";
  import { playFeedback } from "../../../lib/feedback";
  import { clearFeedback, renderFeedback } from "../../../lib/feedback-panel";
  import { fetchGameQuestions, GAME_SIZE } from "../../../lib/questions/api";
  import { checkAnswer, submitAttempt } from "../../../lib/questions/server";
  import { renderScene } from "../../../lib/scene";
  import {
    lockOptions,
    renderQuestion,
    type QuestionView,
  } from "../../../lib/question-view";
  import type {
    AnswerResult,
    Operation,
    PublicQuestion,
    SubmittedAnswer,
  } from "../../../lib/questions/types";

  // ---------- Elementos da página ----------
  const main = document.querySelector<HTMLElement>("main")!;
  const operation = main.dataset.operation as Operation;

  const mensagemAcesso = document.querySelector<HTMLElement>("#mensagem-acesso")!;
  const areaJogo = document.querySelector<HTMLElement>("#area-jogo")!;

  const estados = ["carregando", "erro", "vazio", "jogo", "resultado"] as const;
  type Estado = (typeof estados)[number];

  const secoes: Record<Estado, HTMLElement> = {
    carregando: document.querySelector("#estado-carregando")!,
    erro: document.querySelector("#estado-erro")!,
    vazio: document.querySelector("#estado-vazio")!,
    jogo: document.querySelector("#jogo")!,
    resultado: document.querySelector("#resultado")!,
  };

  const progresso = document.querySelector<HTMLElement>("#progresso")!;
  const btnProxima = document.querySelector<HTMLButtonElement>("#btn-proxima")!;
  const btnTentarDeNovo =
    document.querySelector<HTMLButtonElement>("#btn-tentar-de-novo")!;
  const resultadoTexto = document.querySelector<HTMLElement>("#resultado-texto")!;
  const painelFeedback =
    document.querySelector<HTMLElement>("[data-feedback-panel]")!;

  const view: QuestionView = {
    prompt: document.querySelector<HTMLElement>("[data-prompt]")!,
    scene: document.querySelector<HTMLElement>("[data-scene]")!,
    options: document.querySelector<HTMLElement>("[data-options]")!,
  };

  // ---------- Estado da partida ----------
  let perguntas: PublicQuestion[] = [];
  let indiceAtual = 0;
  let respostas: SubmittedAnswer[] = [];
  let ultimaMensagemAcerto: string | undefined;
  let respondendo = false;

  function mostrar(estado: Estado) {
    for (const nome of estados) secoes[nome].hidden = nome !== estado;
  }

  // ---------- Acesso: só aluno logado ----------
  async function verificarAcessoAluno(): Promise<boolean> {
    const {
      data: { session },
      error: erroSessao,
    } = await supabase.auth.getSession();

    if (erroSessao) {
      mensagemAcesso.textContent =
        "Não foi possível verificar seu acesso. Tente novamente.";
      return false;
    }

    if (!session) {
      window.location.replace("/login");
      return false;
    }

    const { data: perfil, error: erroPerfil } = await supabase
      .from("profiles")
      .select("role")
      .eq("user_id", session.user.id)
      .maybeSingle();

    if (erroPerfil) {
      mensagemAcesso.textContent =
        "Não foi possível verificar seu perfil. Tente novamente.";
      return false;
    }

    if (perfil?.role === "teacher") {
      window.location.replace("/professor");
      return false;
    }

    if (perfil?.role !== "student") {
      await supabase.auth.signOut();
      window.location.replace("/login");
      return false;
    }

    return true;
  }

  // ---------- Carregar a partida ----------
  async function carregarPerguntas() {
    mostrar("carregando");
    respostas = [];
    indiceAtual = 0;
    ultimaMensagemAcerto = undefined;

    try {
      perguntas = await fetchGameQuestions(operation);
    } catch (e) {
      console.error(e);
      mostrar("erro");
      return;
    }

    if (perguntas.length < GAME_SIZE) {
      mostrar("vazio");
      return;
    }

    mostrarPergunta();
    mostrar("jogo");
  }

  // ---------- Mostrar uma pergunta ----------
  function mostrarPergunta() {
    const pergunta = perguntas[indiceAtual];
    respondendo = false;

    progresso.textContent = `Pergunta ${indiceAtual + 1} de ${perguntas.length}`;
    btnProxima.textContent =
      indiceAtual === perguntas.length - 1 ? "Ver resultado" : "Próxima pergunta";
    btnProxima.hidden = true;
    clearFeedback(painelFeedback);

    renderQuestion(view, pergunta, (optionId) => responder(pergunta, optionId));
  }

  // Libera as alternativas de novo (usado quando a conferência falha).
  function destravarAlternativas() {
    delete view.options.dataset.locked;
    view.options.querySelectorAll<HTMLButtonElement>(".option").forEach((botao) => {
      botao.removeAttribute("aria-disabled");
      delete botao.dataset.state;
    });
  }

  // ---------- Responder ----------
  async function responder(pergunta: PublicQuestion, optionId: string) {
    if (respondendo) return;
    respondendo = true;
    lockOptions(view, optionId);

    // O servidor (check-answer) diz se acertou. O gabarito nunca vem para cá.
    let resultado: AnswerResult;
    try {
      resultado = await checkAnswer(pergunta.id, optionId);
    } catch (e) {
      console.error(e);
      renderFeedback(painelFeedback, {
        tone: "try-again",
        message: "Não deu para conferir essa resposta agora. Tente de novo.",
        animation: "none",
        explanation: "",
      });
      destravarAlternativas();
      respondendo = false;
      return;
    }

    respostas.push({ question_id: pergunta.id, option_id: optionId });

    const exibir = buildFeedback(resultado, ultimaMensagemAcerto);
    if (resultado.correct) ultimaMensagemAcerto = exibir.message;

    // Divisão começa como "monte" (não revela a resposta);
    // depois de responder, a cena mostra os grupos.
    if (pergunta.operation === "division") {
      renderScene(view.scene, pergunta.content.scene, "groups");
    }

    renderFeedback(painelFeedback, exibir);
    await playFeedback(view.scene, exibir.animation);

    btnProxima.hidden = false;
    btnProxima.focus();
  }

  // ---------- Finalizar e salvar ----------
  async function finalizarPartida() {
    mostrar("carregando");

    try {
      // O servidor calcula e salva a pontuação; aqui só enviamos as respostas.
      const resultado = await submitAttempt(operation, respostas);
      resultadoTexto.textContent = buildResultMessage(
        resultado.correct_answers,
        resultado.total_questions,
      );
      mostrar("resultado");
    } catch (e) {
      console.error("[submit-attempt] falhou", e);
      mostrar("erro");
    }
  }

  // ---------- Eventos ----------
  btnProxima.addEventListener("click", async () => {
    indiceAtual++;
    if (indiceAtual < perguntas.length) {
      mostrarPergunta();
    } else {
      await finalizarPartida();
    }
  });

  // Se todas as respostas já foram dadas, tenta só salvar de novo
  // (sem obrigar a criança a jogar tudo outra vez).
  btnTentarDeNovo.addEventListener("click", async () => {
    if (respostas.length === GAME_SIZE) {
      await finalizarPartida();
    } else {
      await carregarPerguntas();
    }
  });

  // ---------- Início ----------
  const autorizado = await verificarAcessoAluno();
  if (autorizado) {
    mensagemAcesso.hidden = true;
    areaJogo.hidden = false;
    await carregarPerguntas();
  }
</script>