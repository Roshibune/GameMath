---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Área do aluno — GameMath">
  <main class="aluno-entrada">
    <h1>Área do aluno</h1>
    <p id="saudacao">Carregando...</p>
    <a class="botao-principal" href="/aluno/jogar">Começar a jogar</a>
  </main>
</Layout>

<style>
  .aluno-entrada {
    padding: 1.5rem;
    text-align: center;
  }
  .botao-principal {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    background: var(--fb-block, #4f7cff);
    color: white;
    text-decoration: none;
    font-weight: bold;
  }
</style>

<script>
  import { supabase } from "../../lib/supabase";

  const saudacao = document.querySelector<HTMLElement>("#saudacao")!;

  const {
    data: { session },
    error: sessionError,
  } = await supabase.auth.getSession();

  if (sessionError) {
    saudacao.textContent = "Não foi possível verificar seu acesso. Tente novamente.";
  } else if (!session) {
    window.location.replace("/login");
  } else {
    const { data: perfil, error: perfilError } = await supabase
      .from("profiles")
      .select("role")
      .eq("user_id", session.user.id)
      .maybeSingle();

    if (perfilError) {
      saudacao.textContent = "Não foi possível verificar seu perfil. Tente novamente.";
    } else if (perfil?.role === "teacher") {
      window.location.replace("/professor");
    } else if (perfil?.role === "student") {
      saudacao.textContent = "Pronto para praticar?";
    } else {
      await supabase.auth.signOut();
      window.location.replace("/login");
    }
  }
</script>
